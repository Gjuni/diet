# =============================================================================
# 다이어트 기록 API 서버 환경변수 (복사해서 .env 로 사용: cp .env.example .env)
# =============================================================================
NODE_ENV=development
PORT=4000

# --- DB (PostgreSQL 15+) -----------------------------------------------------
DATABASE_URL=postgres://diet:diet@localhost:5432/diet
PG_POOL_MAX=10

# --- 인증 ---------------------------------------------------------------------
# 32자 이상 랜덤 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# PBKDF2 반복 횟수 (600000 미만 불가). 올리면 다음 로그인 때 자동으로 재해시된다.
PASSWORD_ITERATIONS=600000
# 운영(HTTPS)에서는 반드시 true. 로컬 http 개발이면 false 로 둘 수 있다.
COOKIE_SECURE=true
# 프론트를 다른 출처에서 서빙할 때만 (쉼표 구분). 같은 출처(리버스 프록시)면 비워 둔다.
CORS_ORIGIN=
# 리버스 프록시 뒤라면 홉 수(예: 1) 또는 loopback
TRUST_PROXY=loopback

# --- Gemini (키는 서버에만 둔다) ----------------------------------------------
# 여러 개면 쉼표로 구분 → 키 풀로 rotation / failover / hedging
# 무료 티어 쿼터는 "프로젝트" 단위라, 같은 프로젝트의 키를 여러 개 넣어도 한도는 늘지 않는다.
GEMINI_API_KEYS=key-1,key-2,key-3
# (하위 호환) 단일 키
GEMINI_API_KEY=
# 최신 Stable Flash. thinking level 은 low / medium / high 지원 (minimal 미지원)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium
# 사진 분석 1건 전체 제한 시간 (failover / hedging 포함)
GEMINI_TIMEOUT_MS=30000
GEMINI_BATCH_TIMEOUT_MS=90000
GEMINI_MAX_OUTPUT_TOKENS=8192
# 이미지 토큰: MEDIA_RESOLUTION_LOW(280) / MEDIUM(560) / HIGH(1120). 비우면 모델 기본(1120)
GEMINI_MEDIA_RESOLUTION=

# 스트리밍 + 끊김/정체 감지
GEMINI_STREAM=true
GEMINI_STREAM_THOUGHTS=true
GEMINI_STALL_TIMEOUT_MS=15000
# 첫 응답이 이 시간 안에 없으면 다른 키로 병렬 요청 (0 = 끔)
GEMINI_HEDGE_AFTER_MS=8000
GEMINI_HEDGE_MIN_BUDGET_RATIO=0.5

# 키당 한도 (AI Studio > Rate limits 에서 모델별 값을 확인해 입력하면 429 없이 선제 분산).
# 0 = 모름 → 429 응답을 보고 자동으로 학습한다.
GEMINI_RPM_PER_KEY=0
GEMINI_TPM_PER_KEY=0
GEMINI_RPD_PER_KEY=0
GEMINI_MAX_CONCURRENCY_PER_KEY=4
GEMINI_QUEUE_WAIT_MS=12000
GEMINI_MAX_QUEUE=100
# 주간 배치는 일일 한도의 이 비율을 사용자 사진 분석용으로 남겨 둔다
GEMINI_BATCH_RESERVE_RATIO=0.2
# 무료 티어 일일 쿼터 리셋 기준 (태평양 시간 자정)
GEMINI_QUOTA_TZ=America/Los_Angeles

# 개발용: Gemini 없이 고정 응답으로 화면 흐름 확인 (production 에서는 무시)
AI_MOCK=false

# --- 사진 분석 작업 -----------------------------------------------------------
# 사용자당 하루 AI 분석 횟수
ANALYZE_DAILY_LIMIT=50
# 이미지는 분석 동안만 서버 임시 디렉터리에 (작업별 키로) 암호화 저장, 끝나면 즉시 파기
ANALYSIS_IMAGE_TTL_SEC=300
# 비우면 OS 임시 디렉터리/diet-analysis. 가능하면 tmpfs(메모리 디스크) 경로 권장
ANALYSIS_TMP_DIR=
ANALYSIS_WORKER_CONCURRENCY=0
ANALYSIS_MAX_PENDING_PER_USER=3
ANALYSIS_DEDUP_WINDOW_SEC=600

# --- 메일 (임시 비밀번호 / 변경 알림) -----------------------------------------
# smtp | console(개발용: 메일 내용을 서버 콘솔에 출력)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=다이어트 기록 <no-reply@example.com>
# 메일 본문 링크용 프론트엔드 주소
APP_BASE_URL=http://localhost:5173

# --- 배치 --------------------------------------------------------------------
# true: 서버 안에서 주간 조정(월 00:05 KST + 재시도)과 일일 정리를 실행
# false: 외부 cron 에서 `npm run job:weekly:prod` 실행 (README 참고)
ENABLE_SCHEDULER=true
